#!/usr/bin/env python3
"""wpm — Weighted Persistent Memory CLI (shim, Lot 2B).

Delegates to wpm_mcp_server.cli.main — the monolith at scripts/wpm:777
has been split into wpm_mcp_server/cli/ (prompt_toolkit etc.).
Kept as a file so install.sh:62 `cp scripts/wpm $BIN_DIR/wpm` still works
and direct `./scripts/wpm` remains runnable without pip install -e.
"""

from __future__ import annotations

import sys
from pathlib import Path

try:
    from wpm_mcp_server.cli.main import main  # type: ignore
except ImportError:
    # Running from repo without `pip install -e` — add src to sys.path
    SRC = Path(__file__).resolve().parents[1] / "wpm-mcp-server" / "src"
    if str(SRC) not in sys.path:
        sys.path.insert(0, str(SRC))
    from wpm_mcp_server.cli.main import main  # type: ignore

if __name__ == "__main__":
    main()
