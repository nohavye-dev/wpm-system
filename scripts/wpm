#!/usr/bin/env python3
"""wpm — Weighted Persistent Memory CLI.

`wpm enable` writes wpm.config.json for the current project (with
confirmation). Register the MCP server once in your host — see
docs/fr/setup.md.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
from pathlib import Path

DATA_DIR = os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local" / "share" / "wpm-system"))
BIN_DIR = os.environ.get("XDG_BIN_HOME", str(Path.home() / ".local" / "bin"))


def _resolve_wpm_config() -> Path:
    return Path.cwd() / "wpm.config.json"


def _contained_in_project(db_path_raw: str) -> Path:
    """Validate db_path lives inside the current project; return the resolved path."""
    from wpm_mcp_server import db
    root = Path.cwd()
    return db.resolve_within_root(db_path_raw, root)


# ── enable ──────────────────────────────────────────────────────────────

def cmd_enable(db_dir: str | None, assume_yes: bool) -> None:
    config_path = _resolve_wpm_config()
    exists = config_path.exists()

    data: dict = {}
    if exists:
        data = json.loads(config_path.read_text(encoding="utf-8"))
    if not data.get("db_path"):
        data["db_path"] = f"{db_dir}/wpm.db" if db_dir else ".wpm/wpm.db"

    resolved = _contained_in_project(data["db_path"])

    if not assume_yes:
        try:
            answer = input(
                f"Write {config_path} with db_path={data['db_path']}? [y/N] "
            )
        except (EOFError, KeyboardInterrupt):
            answer = ""
        if answer.strip().lower() not in ("y", "yes"):
            print("wpm: aborted — nothing written")
            sys.exit(0)

    config_path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")

    rel_path = os.path.relpath(str(resolved), str(Path.cwd()))
    db_dir_path = os.path.dirname(rel_path)
    if db_dir_path and db_dir_path != ".":
        (Path.cwd() / db_dir_path).mkdir(parents=True, exist_ok=True)
        gitignore_entry = db_dir_path + os.sep
    else:
        gitignore_entry = os.path.basename(rel_path)

    gitignore = Path.cwd() / ".gitignore"
    if not gitignore.exists() or gitignore_entry not in gitignore.read_text(encoding="utf-8"):
        with gitignore.open("a", encoding="utf-8") as f:
            f.write(f"# weighted persistent memory\n{gitignore_entry}\n")

    from wpm_mcp_server import db as wdb
    conn = wdb.connect(str(resolved))
    conn.close()

    print(f"wpm: activated (wpm.config.json written, db_path={data['db_path']})")
    print("wpm: now register the MCP server once in opencode — see docs/fr/setup.md")


# ── disable ─────────────────────────────────────────────────────────────

def cmd_disable() -> None:
    config_path = _resolve_wpm_config()
    db_path = None
    if config_path.exists():
        data = json.loads(config_path.read_text(encoding="utf-8"))
        db_path = data.get("db_path")
        config_path.unlink()
    print("wpm: wpm.config.json removed")
    if db_path:
        print(f"note: the database at {db_path} was NOT deleted")
    print("note: remove the 'wpm' MCP server entry from your host")
    print("      configuration (opencode.json) — it stays active until then")


# ── uninstall ───────────────────────────────────────────────────────────

def cmd_uninstall(force: bool = False) -> None:
    if not force:
        print("This will remove the server venv, data and the 'wpm' binary.")
        try:
            answer = input("Continue? [y/N] ")
        except (EOFError, KeyboardInterrupt):
            answer = ""
        if answer.strip().lower() not in ("y", "yes"):
            print("wpm: aborted")
            return

    data_path = Path(DATA_DIR)
    if data_path.exists():
        shutil.rmtree(data_path)

    wpm_bin = Path(BIN_DIR) / "wpm"
    if wpm_bin.exists():
        wpm_bin.unlink()

    print("wpm: fully uninstalled")
    print("note: remove any 'wpm' MCP server entry from your host configurations")


# ── plugin ──────────────────────────────────────────────────────────────

def _opencode_plugin_dir() -> Path:
    config_home = os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
    return Path(config_home) / "opencode" / "plugins"


def cmd_plugin(action: str, source: str | None) -> None:
    plugin_dir = _opencode_plugin_dir()
    target = plugin_dir / "wpm-plugin.ts"

    if action == "install":
        src = Path(source) if source else Path(DATA_DIR) / "plugin.ts"
        if not src.exists():
            print(
                f"wpm: plugin source not found at {src}\n"
                "Re-run ./install.sh (which copies plugin.ts), or pass "
                "--source <path/to/plugin.ts>.",
                file=sys.stderr,
            )
            sys.exit(1)
        plugin_dir.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, target)
        print(f"wpm: plugin installed to {target}")
        print("wpm: restart opencode for it to take effect")
    elif action == "uninstall":
        if target.exists():
            target.unlink()
            print(f"wpm: plugin removed ({target})")
        else:
            print("wpm: plugin not installed")
    else:
        print(f"wpm: unknown plugin action: {action}", file=sys.stderr)
        sys.exit(1)


# ── search ──────────────────────────────────────────────────────────────

def cmd_search(args: argparse.Namespace) -> None:
    config_path = _resolve_wpm_config()
    if not config_path.exists():
        print("wpm: not activated here. Run 'wpm enable' first.", file=sys.stderr)
        sys.exit(1)

    config = json.loads(config_path.read_text(encoding="utf-8"))
    db_path_raw = config.get("db_path", "")
    if not db_path_raw:
        print("wpm: db_path not set in wpm.config.json", file=sys.stderr)
        sys.exit(1)

    db_path = Path(db_path_raw)
    if not db_path.is_absolute():
        db_path = (Path.cwd() / db_path_raw).resolve()

    if not db_path.exists():
        print(f"wpm: database not found at {db_path}", file=sys.stderr)
        sys.exit(1)

    import logging
    import warnings
    logging.root.handlers.clear()
    logging.root.addHandler(logging.NullHandler())
    logging.root.setLevel(logging.CRITICAL)
    warnings.filterwarnings("ignore")

    from wpm_mcp_server import db
    from wpm_mcp_server.embeddings import get_provider
    from wpm_mcp_server.repository import Repository
    from wpm_mcp_server.settings import load_settings

    settings = load_settings(config_path)
    os.chdir(str(Path.cwd()))
    conn = db.connect(str(db_path))
    embedder = get_provider()
    repo = Repository(conn=conn, embedder=embedder, settings=settings.domain)

    result = repo.query_context(
        query=args.query,
        min_confidence=args.min_confidence or 0.0,
        token_budget=999_999,
    )
    conn.close()

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        _print_text(result)


def _print_text(result: dict) -> None:
    direct = result.get("direct_matches", [])
    related = result.get("related_context", [])
    conflicts = result.get("conflicts", [])

    if direct:
        print(f"Direct matches ({len(direct)}):")
        for m in direct:
            eid = m["entry_id"][:8]
            typ = m["type"]
            conf = m["confidence"]
            score = m.get("score", conf)
            status = m.get("status", "active")
            content = m["content"].replace("\n", " ")[:80]
            print(f"  {eid}  {typ:<16} {conf:.2f}  {score:.2f}  {status:<9} {content}")
        print()

    if related:
        print(f"Related context ({len(related)}):")
        for m in related:
            eid = m["entry_id"][:8]
            typ = m["type"]
            score = m.get("score", 0)
            status = m.get("status", "active")
            content = m["content"].replace("\n", " ")[:80]
            print(f"  {eid}  {typ:<16} {score:.2f}  {status:<9} {content}")
        print()

    if conflicts:
        print("Conflicts:")
        for c in conflicts:
            src = c["entry_id"][:8]
            tgt = c["contradicted_by"][:8]
            print(f"  {src}  ↔  {tgt}")
    else:
        action = any([direct, related])
        if action:
            print("Conflicts: none")


# ── main ────────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(prog="wpm")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("enable", help="Activate wpm in this project (writes wpm.config.json)")
    p.add_argument("db_dir", nargs="?", default=None)
    p.add_argument("--yes", "-y", action="store_true", help="Skip confirmation")
    sub.add_parser("disable", help="Remove wpm.config.json (keeps the database)")
    u = sub.add_parser("uninstall", help="Fully remove wpm from the system")
    u.add_argument("--force", "-f", action="store_true", help="Skip confirmation")

    p = sub.add_parser("search", help="Search the project's persistent memory")
    p.add_argument("query", help="Search query (in English)")
    p.add_argument("--json", "-j", action="store_true", help="Output as JSON")
    p.add_argument("--min-confidence", "-c", type=float, default=None,
                   help="Minimum confidence threshold (default: no filter)")

    pl = sub.add_parser("plugin", help="Install/uninstall the optional OpenCode plugin")
    pl.add_argument("action", choices=["install", "uninstall"])
    pl.add_argument("--source", help="Path to plugin.ts (default: the copy shipped by install.sh)")

    args = parser.parse_args()

    if args.command == "enable":
        cmd_enable(args.db_dir, args.yes)
    elif args.command == "disable":
        cmd_disable()
    elif args.command == "uninstall":
        cmd_uninstall(args.force)
    elif args.command == "search":
        cmd_search(args)
    elif args.command == "plugin":
        cmd_plugin(args.action, args.source)
    else:
        parser.print_usage()
        sys.exit(1)


if __name__ == "__main__":
    main()
