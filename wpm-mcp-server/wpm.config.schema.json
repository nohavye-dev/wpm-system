{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wpm.config.json",
  "description": "Configuration of the WPM weighted persistent memory system. Unknown keys fail loudly at server startup; '$'-prefixed meta-keys are tolerated for editors.",
  "type": "object",
  "$comment": "Generated by scripts/generate_config_schema.py — do not edit by hand.",
  "properties": {
    "db_path": {
      "type": "string",
      "description": "Path of the SQLite memory database, relative to this file. Required for an active server."
    },
    "confidence_threshold": {
      "type": "number",
      "description": "Minimum confidence for an entry to enter the <project-rules> block."
    },
    "verification_command_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra regexes ADDED to the built-in strong-evidence command list."
    },
    "response_language": {
      "type": "string",
      "description": "Agent response language (\"auto\" or null = user language; fixed value forces it). Never governs stored content."
    },
    "rag_similarity_threshold": {
      "type": "number",
      "description": "Minimum cosine similarity between the raw user message and an entry for the RAG pop-in."
    },
    "rag_max_items": {
      "type": "integer",
      "description": "Maximum entries injected per turn by the RAG pop-in."
    },
    "domain": {
      "description": "DomainSettings sub-section.",
      "type": "object",
      "properties": {
        "provenance": {
          "description": "ProvenanceSettings sub-section.",
          "type": "object",
          "properties": {
            "base_confidence": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "Starting confidence per source type."
            },
            "default": {
              "type": "number",
              "description": "Default provenance confidence."
            }
          },
          "additionalProperties": false
        },
        "decay": {
          "description": "DecaySettings sub-section.",
          "type": "object",
          "properties": {
            "lambda_per_type": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "Confidence erosion rate per entry type."
            },
            "default_lambda": {
              "type": "number",
              "description": "Default erosion rate."
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "description": "EvidenceSettings sub-section.",
          "type": "object",
          "properties": {
            "confirm_weight": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "Confidence delta per evidence type supporting an entry."
            },
            "contradict_weight": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "Confidence delta per evidence type contradicting an entry."
            }
          },
          "additionalProperties": false
        },
        "validation": {
          "description": "ValidationSettings sub-section.",
          "type": "object",
          "properties": {
            "score_min": {
              "type": "number",
              "description": "Lower bound of the validation score."
            },
            "score_max": {
              "type": "number",
              "description": "Upper bound of the validation score."
            },
            "dedup_window_seconds": {
              "type": "integer",
              "description": "Window during which identical evidence events are deduplicated."
            }
          },
          "additionalProperties": false
        },
        "retrieval": {
          "description": "RetrievalSettings sub-section.",
          "type": "object",
          "properties": {
            "weight_similarity": {
              "type": "number",
              "description": "Composite score weight: similarity."
            },
            "weight_confidence": {
              "type": "number",
              "description": "Composite score weight: confidence."
            },
            "weight_centrality": {
              "type": "number",
              "description": "Composite score weight: centrality."
            },
            "min_similarity": {
              "type": "number",
              "description": "Similarity floor below which a candidate entry is discarded."
            }
          },
          "additionalProperties": false
        },
        "expansion": {
          "description": "ExpansionSettings sub-section.",
          "type": "object",
          "properties": {
            "hop_decay": {
              "type": "number",
              "description": "Multiplier applied per graph-expansion hop."
            },
            "min_confidence": {
              "type": "number",
              "description": "Confidence floor for expansion results."
            },
            "top_n_candidates": {
              "type": "integer",
              "description": "Vector-search candidate pool size."
            },
            "auto_link_similarity_threshold": {
              "type": "number",
              "description": "Similarity above which two entries are auto-linked."
            },
            "contradiction_alert_threshold": {
              "type": "number",
              "description": "Score threshold triggering contradiction alerts."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^\\$": {}
  }
}
